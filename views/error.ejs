<% if (authenticated) { %>
<div class="d-flex align-items-center gap-2 mb-4">
  <a href="/" class="btn btn-sm btn-outline-secondary"><i class="bi bi-house"></i> Home</a>
</div>
<% } %>
<div class="card chart-card">
  <div class="card-body text-center py-5">
    <i class="bi bi-emoji-frown text-secondary" style="font-size: 4rem;"></i>
    <h4 class="mt-3"><%= title %></h4>
    <p class="text-secondary"><%= message %></p>
    <% if (!authenticated) { %><a href="/login" class="btn btn-primary">Go to Login</a><% } %>
  </div>
</div>
