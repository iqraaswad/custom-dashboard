<% if (indexerRequired) { %>
<div class="alert alert-info d-flex align-items-center gap-3">
  <i class="bi bi-info-circle-fill fs-4"></i>
  <div>
    <strong>Indexer connection required</strong><br>
    <small>Security alerts are stored in the Wazuh Indexer (OpenSearch/Elasticsearch), not the Manager API.
    To enable alerts, set these in your <code>.env</code> file:</small>
    <pre class="mb-0 mt-2 small"><code>WAZUH_INDEXER_URL=https://your-indexer:9200
INDEXER_USER=admin
INDEXER_PASS=admin</code></pre>
  </div>
</div>
<% } else { %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0"><i class="bi bi-exclamation-triangle text-danger"></i> Alerts</h4>
  <form class="d-flex gap-2" method="GET" action="/alerts">
    <select name="level" class="form-select form-select-sm" style="width: auto;">
      <option value="">All Levels</option>
      <% for (let l = 0; l <= 15; l++) { %>
      <option value="<%= l %>" <%= level == String(l) ? 'selected' : '' %>>Level <%= l %></option>
      <% } %>
    </select>
    <input type="text" name="search" class="form-control form-control-sm" placeholder="Search alerts..." value="<%= search %>" style="width: 200px;">
    <button type="submit" class="btn btn-sm btn-outline-danger">Filter</button>
    <% if (search || level) { %><a href="/alerts" class="btn btn-sm btn-outline-secondary">Clear</a><% } %>
  </form>
</div>
<% } %>

<div class="card chart-card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>Timestamp</th>
          <th>Level</th>
          <th>Rule ID</th>
          <th>Description</th>
          <th>Agent</th>
          <th>Location</th>
        </tr>
      </thead>
      <tbody>
        <% if (alerts.length === 0 && !indexerRequired) { %>
        <tr><td colspan="6" class="text-center text-body-secondary py-4">No alerts found.</td></tr>
        <% } %>
        <% alerts.forEach(function(a) { %>
        <% const lvl = a.rule?.level || a.level || 0; %>
        <tr>
          <td class="small text-nowrap"><%= a.timestamp || a['@timestamp'] || '-' %></td>
          <td><span class="badge bg-<%= lvl >= 12 ? 'danger' : lvl >= 8 ? 'warning' : lvl >= 4 ? 'info' : 'secondary' %>"><%= lvl %></span></td>
          <td><code><%= a.rule?.id || '-' %></code></td>
          <td class="small"><%= a.rule?.description || '-' %></td>
          <td class="small"><%= a.agent?.name || a.agent || '-' %></td>
          <td class="small"><%= a.location || '-' %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<% if (totalPages > 1) { %>
<nav class="mt-3">
  <ul class="pagination pagination-sm justify-content-center">
    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
      <a class="page-link" href="?page=<%= page - 1 %>&limit=<%= limit %><%= search ? '&search=' + search : '' %><%= level ? '&level=' + level : '' %>">Previous</a>
    </li>
    <% for (let i = Math.max(1, page - 2); i <= Math.min(totalPages, page + 2); i++) { %>
    <li class="page-item <%= i === page ? 'active' : '' %>">
      <a class="page-link" href="?page=<%= i %>&limit=<%= limit %><%= search ? '&search=' + search : '' %><%= level ? '&level=' + level : '' %>"><%= i %></a>
    </li>
    <% } %>
    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
      <a class="page-link" href="?page=<%= page + 1 %>&limit=<%= limit %><%= search ? '&search=' + search : '' %><%= level ? '&level=' + level : '' %>">Next</a>
    </li>
  </ul>
</nav>
<% } %>
<% if (total > 0) { %>
<p class="text-body-secondary small text-center mt-2">Showing <%= alerts.length %> of <%= total %> alerts</p>
<% } %>
