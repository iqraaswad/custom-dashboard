<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0"><i class="bi bi-pc-display text-info"></i> Agents</h4>
  <form class="d-flex gap-2" method="GET" action="/agents">
    <select name="status" class="form-select form-select-sm" style="width: auto;">
      <option value="">All Status</option>
      <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="disconnected" <%= status === 'disconnected' ? 'selected' : '' %>>Disconnected</option>
      <option value="never_connected" <%= status === 'never_connected' ? 'selected' : '' %>>Never Connected</option>
    </select>
    <input type="text" name="search" class="form-control form-control-sm" placeholder="Search agents..." value="<%= search %>" style="width: 200px;">
    <button type="submit" class="btn btn-sm btn-outline-info">Filter</button>
    <% if (search || status) { %><a href="/agents" class="btn btn-sm btn-outline-secondary">Clear</a><% } %>
  </form>
</div>

<div class="card chart-card">
  <div class="card-body p-0">
    <table class="table table-dark table-hover mb-0">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>IP</th>
          <th>Status</th>
          <th>OS</th>
          <th>Version</th>
          <th>Last Keep Alive</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (agents.length === 0) { %>
        <tr><td colspan="8" class="text-center text-secondary py-4">No agents found.</td></tr>
        <% } %>
        <% agents.forEach(function(a) { %>
        <tr>
          <td><code><%= a.id %></code></td>
          <td><%= a.name %></td>
          <td class="small"><%= a.ip || '-' %></td>
          <td>
            <span class="badge bg-<%= a.status === 'active' ? 'success' : a.status === 'disconnected' ? 'danger' : 'secondary' %>"><%= a.status %></span>
          </td>
          <td class="small"><%= a.os?.name || a.os || '-' %></td>
          <td class="small"><%= a.version || '-' %></td>
          <td class="small text-nowrap"><%= a.lastKeepAlive || '-' %></td>
          <td><a href="/agents/<%= a.id %>" class="btn btn-sm btn-outline-info">Detail</a></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<% if (totalPages > 1) { %>
<nav class="mt-3">
  <ul class="pagination pagination-sm justify-content-center">
    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
      <a class="page-link bg-dark text-light border-secondary" href="?page=<%= page - 1 %>&limit=<%= limit %><%= search ? '&search=' + search : '' %><%= status ? '&status=' + status : '' %>">Previous</a>
    </li>
    <% for (let i = Math.max(1, page - 2); i <= Math.min(totalPages, page + 2); i++) { %>
    <li class="page-item <%= i === page ? 'active' : '' %>">
      <a class="page-link bg-dark text-light border-secondary" href="?page=<%= i %>&limit=<%= limit %><%= search ? '&search=' + search : '' %><%= status ? '&status=' + status : '' %>"><%= i %></a>
    </li>
    <% } %>
    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
      <a class="page-link bg-dark text-light border-secondary" href="?page=<%= page + 1 %>&limit=<%= limit %><%= search ? '&search=' + search : '' %><%= status ? '&status=' + status : '' %>">Next</a>
    </li>
  </ul>
</nav>
<% } %>
<p class="text-secondary small text-center mt-2">Showing <%= agents.length %> of <%= total %> agents</p>
