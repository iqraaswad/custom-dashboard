{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "mcp_servers": {
            "type": "local",
            "enabled": true,
            "command": [
                "docker",
                "mcp",
                "gateway",
                "run"
            ]
        },
        "skillbook": {
            "type": "local",
            "enabled": true,
            "command": [
                "docker",
                "run",
                "-i",
                "--rm",
                "-e",
                "SKILLBOOK_API_URL=https://iqra-lab.poliupg.ac.id/skillbook/api",
                "-e",
                "SKILLBOOK_API_KEY=cf51a62c8ad7e2be23a585e69c33f562570f2e30a124057c4463cfc3ea9be1b3",
                "ghcr.io/iqraaswad/skillbook-mcp:latest"
            ]
        }
    }
}
